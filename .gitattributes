# Keep executable research scripts portable between Windows and Linux.
*.sh text eol=lf
*.py text eol=lf

# Keep research records readable on all supported platforms.
*.md text eol=lf
*.txt text eol=lf
*.cnf text eol=lf

# Preserve raw measurement bytes so the recorded SHA-256 survives Windows checkouts.
data/raw/pilot/*.csv -text
data/raw/final/**/*.csv -text
